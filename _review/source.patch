@@ -0,0 +1,15 @@
+{% for section in site.data.site_navigation %}
+  {% assign section_active = false %}
+  {% if page.section == section.key or page.url == section.url %}{% assign section_active = true %}{% endif %}
+  <div class="nav-item dropdown ia-nav-item" role="listitem">
+    <a class="nav-link menu-item ia-nav-link{% if section_active %} active{% endif %}" href="{{ section.url | relative_url }}"{% if page.url == section.url %} aria-current="page"{% endif %}>{{ section.title | escape }}</a>
+    <button type="button" class="nav-link ia-nav-disclosure dropdown-toggle" id="{{ section.key }}DropdownToggle" aria-label="Show {{ section.title | escape }} menu" aria-controls="{{ section.key }}DropdownMenu" aria-expanded="false"{% if include.native %} data-nav-dropdown{% else %} data-bs-toggle="dropdown"{% endif %}></button>
+    <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end" id="{{ section.key }}DropdownMenu" aria-labelledby="{{ section.key }}DropdownToggle"{% if include.native %} hidden{% endif %}>
+      <li><a class="dropdown-item" href="{{ section.url | relative_url }}">{{ section.title | escape }} Overview</a></li>
+      <li><hr class="dropdown-divider"></li>
+      {% for child in section.children %}<li><a class="dropdown-item" href="{{ child.url | relative_url }}">{{ child.title | escape }}</a></li>{% endfor %}
+    </ul>
+  </div>
+{% endfor %}
+<div class="nav-item ia-nav-utility" role="listitem"><a class="nav-link menu-item" href="{{ '/search/' | relative_url }}">Search</a></div>
+<div class="nav-item ia-nav-utility" role="listitem"><a class="nav-link menu-item" href="{{ '/subscribe/' | relative_url }}">Subscribe</a></div>
